# ESP32-CAM (AI-Thinker class) - tier B, node 21.

# The chip.
CONFIG_IDF_TARGET="esp32"

# common to all three boards
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Task watchdog
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# D2 throttling via esp_pm_configure
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=1000

# Brownout detector stays ENABLED (CAM power footgun)
CONFIG_ESP_BROWNOUT_DET=y

# CPU frequency is a measured quantity's input
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# All Phase-1 boards have >=4 MB flash (S3 devkit, AI-Thinker CAM, plain ESP32)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# tier B - AI-Thinker class, 4 MB quad PSRAM.
CONFIG_FLEETSPLIT_TIER_B=y
CONFIG_FLEETSPLIT_NODE_ID=21
CONFIG_FLEETSPLIT_ARENA_KB=512
CONFIG_SPIRAM=y
# On the ESP32, 80 MHz PSRAM requires the flash bus at 80 MHz too.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y
# If PSRAM is absent or in the wrong line mode
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

