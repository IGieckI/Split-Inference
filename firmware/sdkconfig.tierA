# Tier A: ESP32-S3 devkit, flash inputs, PSRAM expected (gate G1 verifies).
# NOTE: if the board is an N8R8 (octal PSRAM), set CONFIG_SPIRAM_MODE_OCT=y.
CONFIG_FLEETSPLIT_TIER_A=y
CONFIG_FLEETSPLIT_NODE_ID=11
CONFIG_FLEETSPLIT_ARENA_KB=512
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
